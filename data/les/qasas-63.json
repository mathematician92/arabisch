{"nr":63,"titel":"بَعْدَ الطُّوفانِ","niveau":"Les 63","zinnen":[{"woorden":[{"w":"وَلَمَّا","ids":["wa","lam"]},{"w":"كَانَ","ids":["kan"]},{"w":"مَا","ids":["maa"]},{"w":"أَرَادَهُ","ids":["arad","_hu"]},{"w":"اللَّهُ","ids":["allah"]},{"w":"وَغَرِقَ","ids":["wa","gharaq"]},{"w":"الكُفَّارُ","ids":["al","kafir"]},{"w":"أَمْسَكَتِ","ids":["amsak"]},{"w":"السَّماءُ","ids":["al","sama"]},{"w":"وَغَارَ","ids":["wa","ghar"]},{"w":"المَاءُ","ids":["al","ma_w"]}],"nl":"En toen gebeurd was wat Allah wilde en de ongelovigen verdronken waren, hield de hemel op en zakte het water weg.","eind":"."},{"woorden":[{"w":"وَاسْتَوَتِ","ids":["wa","istawa"]},{"w":"السَّفِينَةُ","ids":["al","safinah"]},{"w":"عَلَى","ids":["ala"]},{"w":"جَبَلِ","ids":["jabal"]},{"w":"الجُودِيِّ","ids":["judi"]},{"w":"وَقِيلَ","ids":["wa","qal"]},{"w":"بُعْداً","ids":["bud"]},{"w":"لِلْقَوْمِ","ids":["li","al","qawm"]},{"w":"الظَّالِمِينَ","ids":["al","zalim"]}],"nl":"En het schip kwam tot rust op de berg al-Jūdī, en er werd gezegd: weg met het onrechtvaardige volk.","eind":"."},{"woorden":[{"w":"وَقِيلَ","ids":["wa","qal"]},{"w":"يَا","ids":["ya"]},{"w":"نُوحُ","ids":["nuh"]},{"w":"اهْبِطْ","ids":["habat"]},{"w":"بِسَلَامٍ","ids":["bi","salam"]}],"nl":"En er werd gezegd: o Nūḥ, daal af in vrede.","eind":"."},{"woorden":[{"w":"وَهَبَطَ","ids":["wa","habat"]},{"w":"نُوحٌ","ids":["nuh"]},{"w":"وَأَصْحَابُ","ids":["wa","sahib"]},{"w":"السَّفِينَةِ","ids":["al","safinah"]},{"w":"يَمْشُونَ","ids":["masha"]},{"w":"عَلَى","ids":["ala"]},{"w":"البَرِّ","ids":["al","barr"]},{"w":"بِسَلَامٍ","ids":["bi","salam"]}],"nl":"En Nūḥ daalde af, en de opvarenden van het schip liepen in vrede over het land.","eind":"."},{"woorden":[{"w":"وَهَلَكَ","ids":["wa","halak"]},{"w":"الكُفَّارُ","ids":["al","kafir"]},{"w":"مِنْ","ids":["min"]},{"w":"قَوْمِ","ids":["qawm"]},{"w":"نُوحٍ","ids":["nuh"]},{"w":"فَما","ids":["fa","maa"]},{"w":"بَكَتْ","ids":["bakay"]},{"w":"عَلَيْهِمُ","ids":["ala","_hum"]},{"w":"السَّمَاءُ","ids":["al","sama"]},{"w":"وَالأَرْضُ","ids":["wa","al","ard"]}],"nl":"En de ongelovigen van het volk van Nūḥ kwamen om, en de hemel en de aarde weenden niet om hen.","eind":"."},{"woorden":[{"w":"وَبَارَكَ","ids":["wa","barak"]},{"w":"اللَّهُ","ids":["allah"]},{"w":"في","ids":["fi"]},{"w":"ذُرِّيَّةِ","ids":["dhurriya"]},{"w":"نُوحٍ","ids":["nuh"]},{"w":"فَانْتَشَرَتْ","ids":["fa","intashar"]},{"w":"في","ids":["fi"]},{"w":"الْأَرْضِ","ids":["al","ard"]},{"w":"وَمَلَأَتِ","ids":["wa","mala"]},{"w":"الْأَرْضَ","ids":["al","ard"]}],"nl":"En Allah zegende het nageslacht van Nūḥ, en het verspreidde zich over de aarde en vulde de aarde.","eind":"."},{"woorden":[{"w":"وَكَانَ","ids":["wa","kan"]},{"w":"فيهَا","ids":["fi","_ha"]},{"w":"أُمَمٌ","ids":["ummah"]},{"w":"وَكَانَ","ids":["wa","kan"]},{"w":"فيهَا","ids":["fi","_ha"]},{"w":"أَنْبِيَاءُ","ids":["nabi"]},{"w":"وَمُلُوكٌ","ids":["wa","malik_q"]}],"nl":"En daaronder waren gemeenschappen, en daaronder waren profeten en koningen.","eind":"."},{"woorden":[{"w":"سَلَامٌ","ids":["salam"]},{"w":"عَلَى","ids":["ala"]},{"w":"نُوحٍ","ids":["nuh"]},{"w":"في","ids":["fi"]},{"w":"الْعَالَمِينَ","ids":["al","alam_q"]}],"nl":"Vrede zij met Nūḥ onder de werelden.","eind":""},{"woorden":[{"w":"سَلَامٌ","ids":["salam"]},{"w":"عَلَى","ids":["ala"]},{"w":"نُوحٍ","ids":["nuh"]},{"w":"في","ids":["fi"]},{"w":"الْعَالَمِينَ","ids":["al","alam_q"]}],"nl":"Vrede zij met Nūḥ onder de werelden.","eind":""}],"lijst":{"ism":["_ha","_hu","_hum","alam_q","allah","ard","barr","bud","dhurriya","ghar","jabal","judi","kafir","ma_w","maa","malik_q","nabi","nuh","qawm","safinah","sahib","salam","sama","ummah","zalim"],"fil":["amsak","arad","bakay","barak","gharaq","habat","halak","intashar","istawa","kan","mala","masha","qal"],"harf":["al","ala","bi","fa","fi","lam","li","min","wa","ya"]},"boek":"qasas"}